{
  "name": "zarr-globe-viewer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "build:asos-manifest": "node --import tsx scripts/build-asos-manifest.ts",
    "build:coastline": "node scripts/build-coastline.mjs",
    "check:static": "node scripts/check-static-build.mjs",
    "check:data": "node --import tsx scripts/check-remote-data.ts",
    "check:ecmwf-data": "node --import tsx scripts/check-ecmwf-arco.ts",
    "check:derived": "node --import tsx scripts/check-derived-variables.ts",
    "check:color-range": "node --import tsx scripts/check-color-range.ts",
    "check:new-data": "node --import tsx scripts/check-new-data.ts",
    "check:queue": "node --import tsx scripts/check-async-queue.ts",
    "check:variables": "node --import tsx scripts/check-common-variables.ts",
    "check:time": "node --import tsx scripts/check-time-axes.ts",
    "check:units": "node --import tsx scripts/check-units.ts",
    "check:meteogram": "node --import tsx scripts/check-meteogram.ts",
    "check:viewer": "node --import tsx scripts/check-viewer-policy.ts",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run lint && npm run typecheck && npm run check:queue && npm run check:variables && npm run check:time && npm run check:units && npm run check:meteogram && npm run check:derived && npm run check:color-range && npm run check:viewer && npm run build && npm run check:static"
  },
  "dependencies": {
    "@carbonplan/zarr-layer": "^0.6.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@mattnucc/gribberish": "^1.7.0",
    "@mattnucc/gribberish-wasm32-wasi": "^1.7.0",
    "@photostructure/tz-lookup": "^11.7.0",
    "hyparquet": "^1.31.5",
    "hyparquet-compressors": "^1.1.2",
    "icechunk-js": "^0.6.1",
    "js-quantities": "^1.8.0",
    "maplibre-gl": "^5.24.0",
    "proj4": "^2.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zarrita": "^0.7.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/js-quantities": "^1.6.6",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.5",
    "world-atlas": "^2.0.2"
  },
  "type": "module"
}
